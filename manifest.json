{
  "manifest_version": 3,
  "name": "ScreenStitcher",
  "version": "1.0",
  "description": "Capture screenshots continuously and convert them to PDF",
  "permissions": [
    "activeTab",
    "contextMenus",
    "downloads",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ScreenStitcher",
    "default_icon": {
      "16": "icons/icon16-v2.png",
      "32": "icons/icon32-v2.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16-v2.png",
    "32": "icons/icon32-v2.png",
    "48": "icons/icon48-v2.png",
    "128": "icons/icon128-v2.png"
  }
}
